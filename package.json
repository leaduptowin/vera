  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "meeting-notes",
    "meeting-minutes",
    "web-speech-api",
    "speech-recognition",
    "realtime",
    "sse",
    "react",
    "typescript",
    "tailwindcss",
    "local-first",
    "ai-summary",
    "browser-only"
  ],
  "homepage": "https://leaduptowin.github.io/vera/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaduptowin/vera.git"
  },
  "bugs": {
    "url": "https://github.com/leaduptowin/vera/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
